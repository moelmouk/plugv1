{
  "manifest_version": 3,
  "name": "Plugin Rec Pro",
  "description": "Extension légère: enregistre et rejoue des actions (click/input) sur la page.",
  "version": "0.1.0",
  "action": {
    "default_title": "Plugin Rec Pro",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
